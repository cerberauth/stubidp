{
  "name": "@cerberauth/stubidp",
  "version": "0.0.3",
  "description": "A mock OpenID Connect server for developers. Zero config, instant OIDC.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "stubidp": "bin/run.js",
    "stubidp-jwks": "bin/generate-jwks.js"
  },
  "files": [
    "build/",
    "bin/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "start": "node bin/run.js",
    "jwks:generate": "node bin/generate-jwks.js",
    "dev": "npm run build:css && npm run build:js && tsc && concurrently -n tsc,css,server -k -c blue,magenta,green \"tsc --watch --preserveWatchOutput\" \"npm:dev:css\" \"npm:dev:server\"",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/output.css --watch=always",
    "dev:server": "node --watch bin/run.js",
    "test": "vitest run",
    "ci-test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/output.css --minify",
    "build:js": "esbuild src/client/telemetry.ts --bundle --minify --format=esm --target=es2020 --outfile=public/telemetry.js",
    "build": "npm run build:css && npm run build:js && tsc",
    "prepublishOnly": "npm run build",
    "build:bun": "npm run build && bun run build:bun:linux-x64 && bun run build:bun:linux-arm64 && bun run build:bun:darwin-x64 && bun run build:bun:darwin-arm64 && bun run build:bun:windows-x64",
    "build:bun:linux-x64": "bun build --compile --target=bun-linux-x64 --outfile=bins/linux_amd64/stubidp bin/run.js",
    "build:bun:linux-arm64": "bun build --compile --target=bun-linux-arm64 --outfile=bins/linux_arm64/stubidp bin/run.js",
    "build:bun:darwin-x64": "bun build --compile --target=bun-darwin-x64 --outfile=bins/darwin_amd64/stubidp bin/run.js",
    "build:bun:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 --outfile=bins/darwin_arm64/stubidp bin/run.js",
    "build:bun:windows-x64": "bun build --compile --target=bun-windows-x64 --outfile=bins/windows_amd64/stubidp.exe bin/run.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:migrate:local": "wrangler d1 migrations apply stubidp-db --local",
    "worker:migrate:remote": "wrangler d1 migrations apply stubidp-db --remote"
  },
  "keywords": [
    "oidc",
    "openid-connect",
    "oauth2",
    "testing",
    "identity-provider",
    "idp",
    "stub",
    "mock",
    "development"
  ],
  "author": "CerberAuth",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/cerberauth/stubidp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerberauth/stubidp.git"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@plausible-analytics/tracker": "0.4.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "oidc-provider": "9.12.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-std-serializers": "7.1.0",
    "quick-lru": "7.3.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@cerberauth/tokens": "0.3.1",
    "@cloudflare/workers-types": "5.20261010.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.6",
    "dotenv": "18.0.7",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "wrangler": "4"
  }
}
